rules_version = '2';

// JobsStory Firestore security rules.
// Phase 1: authentication + roles. Only the profiles collection exists.
// Phase 2+ adds: stories, jobs, applications, companies, reports, notifications.
service cloud.firestore {
  match /databases/{database}/documents {

    // Users may create and maintain ONLY their own profile.
    match /users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.uid == uid;
      allow delete: if false; // profiles are soft-deleted by the admin.
    }

    // Seekers publish their own stories; anyone can read approved ones (Phase 3 feed).
    match /stories/{storyId} {
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.status == 'approved'
      );
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid &&
        resource.data.ownerUid == request.resource.data.ownerUid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;
    }

    // Everything else stays locked until its feature ships.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}