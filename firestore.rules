rules_version = '2';

// JobsStory Firestore security rules.
// Phase 1: profiles + authentication. Phase 2: stories.
// Phase 3: public profiles for the feed, plus likes/saves/reports collections.
// Phase 4: job postings + applications (recruiters own jobs; seekers apply).
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: anyone authenticated may read a public profile for the feed;
    // each user writes only their own profile.
    match /users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.uid == uid;
      allow delete: if false; // profiles are soft-deleted by the admin.
    }

    // Seekers publish their own stories; anyone can read approved ones
    // (the discover feed) but only owners manage their own.
    match /stories/{storyId} {
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.status == 'approved'
      );
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid &&
        resource.data.ownerUid == request.resource.data.ownerUid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;
    }

    // Likes: a user may create/remove only their own like; read-only for all.
    match /likes/{id} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Saves: a user manages only their own saved candidates.
    match /saves/{id} {
      allow create: if request.auth != null &&
        request.resource.data.savedById == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.savedById == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Reports: any authenticated user can file a report; only moderators
    // (Phase 5) may read and resolve them.
    match /reports/{id} {
      allow create: if request.auth != null &&
        request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Jobs: a recruiter creates/updates only their own postings; everyone
    // authenticated may read open jobs, owners may also read their closed ones.
    match /jobs/{jobId} {
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.status == 'open' ||
        resource.data.createdBy == request.auth.uid
      );
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.createdBy &&
        request.resource.data.createdBy == request.auth.uid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.createdBy;
    }

    // Applications: a seeker submits only their own; the applicant and the
    // job owner may read; the recruiter updates status/notes, the seeker
    // may withdraw.
    match /applications/{applicationId} {
      allow create: if request.auth != null &&
        request.resource.data.seekerUid == request.auth.uid;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.seekerUid ||
        isJobOwner(request.auth.uid, resource.data.jobId)
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.seekerUid ||
        isJobOwner(request.auth.uid, resource.data.jobId)
      ) && request.resource.data.seekerUid == resource.data.seekerUid;
      allow delete: if false; // moderation/none in v1.
    }

    function isJobOwner(uid, jobId) {
      return exists(/databases/$(database)/documents/jobs/$(jobId)) &&
        get(/databases/$(database)/documents/jobs/$(jobId)).data.createdBy == uid;
    }

    // Everything else stays locked until its feature ships.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}