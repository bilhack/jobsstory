rules_version = '2';

// JobsStory Firestore security rules.
// Phase 1: profiles + authentication. Phase 2: stories.
// Phase 3: public profiles for the feed, plus likes/saves/reports collections.
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: anyone authenticated may read a public profile for the feed;
    // each user writes only their own profile.
    match /users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.uid == uid;
      allow delete: if false; // profiles are soft-deleted by the admin.
    }

    // Seekers publish their own stories; anyone can read approved ones
    // (the discover feed) but only owners manage their own.
    match /stories/{storyId} {
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.status == 'approved'
      );
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid &&
        resource.data.ownerUid == request.resource.data.ownerUid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;
    }

    // Likes: a user may create/remove only their own like; read-only for all.
    match /likes/{id} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Saves: a user manages only their own saved candidates.
    match /saves/{id} {
      allow create: if request.auth != null &&
        request.resource.data.savedById == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.savedById == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Reports: any authenticated user can file a report; only moderators
    // (Phase 5) may read and resolve them.
    match /reports/{id} {
      allow create: if request.auth != null &&
        request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Everything else stays locked until its feature ships.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}