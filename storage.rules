// JobsStory Cloud Storage rules.
// Phase 1: avatar uploads. Phase 2: story videos (own paths).
service firebase.storage {
  match /b/{bucket}/o {
    // Users may manage only their own avatar.
    match /users/{uid}/{filename} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid &&
        filename == 'avatar.jpg';
    }

    // Story media lives under the owner path. Any signed-in user may read it
    // (only approved stories are reachable via Firestore), while only the
    // owner can upload/delete.
    match /stories/{uid}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else stays locked.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}